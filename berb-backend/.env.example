# --- Database ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=berb

# --- App / auth ---
APP_URL=http://localhost:3000
# >= 32 random chars: openssl rand -base64 48
AUTH_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
ADMIN_SETUP_SECRET=replace-with-at-least-43-random-characters
# Comma separated origins of the public React site (CORS for /api/v1 public endpoints)
ALLOWED_ORIGINS=http://localhost:5173
BUSINESS_TIME_ZONE=Europe/Berlin

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=BERB <jobs@your-verified-domain.com>

# --- Notification worker ---
# Bearer token required by /api/cron/notifications (>= 16 chars)
CRON_SECRET=replace-with-random-string

# --- CLI only (scripts/create-admin.ts) ---
# ADMIN_NAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
